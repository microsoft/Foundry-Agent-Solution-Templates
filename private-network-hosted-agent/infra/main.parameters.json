{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=westus3}"
    },
    "searchLocation": {
      "value": "${AZURE_SEARCH_LOCATION=westus3}"
    },
    "deploymentPrincipalObjectId": {
      "value": "${DEPLOYMENT_PRINCIPAL_OBJECT_ID}"
    },
    "invocationTestPrincipalObjectId": {
      "value": "${INVOCATION_TEST_PRINCIPAL_OBJECT_ID=}"
    },
    "connectivityMode": {
      "value": "${CONNECTIVITY_MODE=pointToSite}"
    },
    "vnetAddressPrefix": {
      "value": "${VNET_ADDRESS_PREFIX=10.42.0.0/16}"
    },
    "agentSubnetPrefix": {
      "value": "${AGENT_SUBNET_PREFIX=10.42.0.0/24}"
    },
    "privateEndpointSubnetPrefix": {
      "value": "${PRIVATE_ENDPOINT_SUBNET_PREFIX=10.42.1.0/24}"
    },
    "firewallSubnetPrefix": {
      "value": "${FIREWALL_SUBNET_PREFIX=10.42.2.0/26}"
    },
    "firewallCreationRequired": {
      "value": "${FPHA_FIREWALL_CREATION_REQUIRED=true}"
    },
    "gatewaySubnetPrefix": {
      "value": "${GATEWAY_SUBNET_PREFIX=10.42.3.0/27}"
    },
    "dnsInboundSubnetPrefix": {
      "value": "${DNS_INBOUND_SUBNET_PREFIX=10.42.4.0/28}"
    },
    "dnsInboundIpAddress": {
      "value": "${DNS_INBOUND_IP_ADDRESS=10.42.4.4}"
    },
    "p2sAddressPool": {
      "value": "${P2S_ADDRESS_POOL=172.20.0.0/24}"
    },
    "p2sTenantId": {
      "value": "${AZURE_TENANT_ID}"
    },
    "s2sGatewayIpAddress": {
      "value": "${S2S_GATEWAY_IP_ADDRESS=}"
    },
    "s2sRemoteAddressPrefixes": {
      "value": "${S2S_REMOTE_ADDRESS_PREFIXES=[]}"
    },
    "s2sEnableBgp": {
      "value": "${S2S_ENABLE_BGP=false}"
    },
    "s2sRemoteAsn": {
      "value": "${S2S_REMOTE_ASN=65010}"
    },
    "s2sBgpPeeringAddress": {
      "value": "${S2S_BGP_PEERING_ADDRESS=}"
    },
    "s2sSharedKey": {
      "value": "${S2S_SHARED_KEY=}"
    },
    "remoteVnetResourceId": {
      "value": "${REMOTE_VNET_RESOURCE_ID=}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.1}"
    },
    "modelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2025-11-13}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=10}"
    },
    "containerRegistryResourceId": {
      "value": "${AZURE_CONTAINER_REGISTRY_RESOURCE_ID=}"
    },
    "containerRegistryEndpoint": {
      "value": "${AZURE_CONTAINER_REGISTRY_ENDPOINT=}"
    }
  }
}
