<policies>
  <inbound>
    <base />
    <llm-content-safety backend-id="foundry-content-safety" shield-prompt="{{policy-content-safety-prompt-shield-enabled}}">
      <categories output-type="EightSeverityLevels">
        <category name="Hate" threshold="{{policy-content-safety-hate-threshold}}" />
        <category name="SelfHarm" threshold="{{policy-content-safety-self-harm-threshold}}" />
        <category name="Sexual" threshold="{{policy-content-safety-sexual-threshold}}" />
        <category name="Violence" threshold="{{policy-content-safety-violence-threshold}}" />
      </categories>
    </llm-content-safety>
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <choose>
      <when condition='@{ var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true); return body == null || body["stream"] == null || !(bool)body["stream"]; }'>
        <llm-content-safety backend-id="foundry-content-safety" shield-prompt="false">
          <categories output-type="EightSeverityLevels">
            <category name="Hate" threshold="{{policy-content-safety-hate-threshold}}" />
            <category name="SelfHarm" threshold="{{policy-content-safety-self-harm-threshold}}" />
            <category name="Sexual" threshold="{{policy-content-safety-sexual-threshold}}" />
            <category name="Violence" threshold="{{policy-content-safety-violence-threshold}}" />
          </categories>
        </llm-content-safety>
      </when>
    </choose>
  </outbound>
  <on-error><base /></on-error>
</policies>
