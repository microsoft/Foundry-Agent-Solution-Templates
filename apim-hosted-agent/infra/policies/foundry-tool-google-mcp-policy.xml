<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(!context.Request.Headers.ContainsKey(&quot;Authorization&quot;) || !context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;).StartsWith(&quot;Bearer &quot;, StringComparison.OrdinalIgnoreCase))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>Bearer error="invalid_token"</value>
          </set-header>
        </return-response>
      </when>
    </choose>
    <send-request mode="new" response-variable-name="googleIdentity" timeout="20" ignore-error="true">
      <set-url>https://openidconnect.googleapis.com/v1/userinfo</set-url>
      <set-method>GET</set-method>
      <set-header name="Authorization" exists-action="override">
        <value>@(context.Request.Headers.GetValueOrDefault("Authorization", ""))</value>
      </set-header>
      <set-header name="Accept" exists-action="override">
        <value>application/json</value>
      </set-header>
    </send-request>
    <choose>
      <when condition="@(!context.Variables.ContainsKey(&quot;googleIdentity&quot;) || context.Variables[&quot;googleIdentity&quot;] == null || ((IResponse)context.Variables[&quot;googleIdentity&quot;]).StatusCode != 200)">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>Bearer error="invalid_token"</value>
          </set-header>
        </return-response>
      </when>
    </choose>
    <set-variable name="googleSubject" value="@((string)(((IResponse)context.Variables[&quot;googleIdentity&quot;]).Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true)[&quot;sub&quot;] ?? &quot;&quot;))" />
    <set-variable name="googleEmail" value="@((string)(((IResponse)context.Variables[&quot;googleIdentity&quot;]).Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true)[&quot;email&quot;] ?? &quot;&quot;))" />
    <choose>
      <when condition="@(string.IsNullOrWhiteSpace((string)context.Variables[&quot;googleSubject&quot;]))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>Bearer error="invalid_token"</value>
          </set-header>
        </return-response>
      </when>
      <when condition="@(!string.IsNullOrWhiteSpace((string)context.Variables[&quot;googleEmail&quot;]) &amp;&amp; (&quot;,&quot; + &quot;{{policy-google-blocked-emails}}&quot;.Replace(&quot; &quot;, &quot;&quot;).ToLowerInvariant() + &quot;,&quot;).Contains(&quot;,&quot; + ((string)context.Variables[&quot;googleEmail&quot;]).ToLowerInvariant() + &quot;,&quot;))">
        <return-response>
          <set-status code="403" reason="Forbidden" />
        </return-response>
      </when>
    </choose>
    <set-variable name="googleMcpToolName" value="@(context.Request.Method.Equals(&quot;POST&quot;, StringComparison.OrdinalIgnoreCase) ? (string)(context.Request.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;(preserveContent: true).SelectToken(&quot;params.name&quot;) ?? &quot;&quot;) : &quot;&quot;)" />
    <choose>
      <when condition="@(!string.IsNullOrWhiteSpace((string)context.Variables[&quot;googleMcpToolName&quot;]) &amp;&amp; (&quot;,&quot; + &quot;{{policy-google-blocked-tools}}&quot;.Replace(&quot; &quot;, &quot;&quot;).ToLowerInvariant() + &quot;,&quot;).Contains(&quot;,&quot; + ((string)context.Variables[&quot;googleMcpToolName&quot;]).ToLowerInvariant() + &quot;,&quot;))">
        <return-response>
          <set-status code="403" reason="Google MCP tool blocked" />
        </return-response>
      </when>
    </choose>
    <rate-limit-by-key
      calls="{{policy-tool-rate-limit-requests}}"
      renewal-period="{{policy-tool-rate-limit-window-seconds}}"
      counter-key='@("google-subject:" + (string)context.Variables["googleSubject"] + "/calls/{{policy-tool-rate-limit-requests}}/window/{{policy-tool-rate-limit-window-seconds}}")'
      retry-after-header-name="Retry-After"
      remaining-calls-header-name="x-google-mcp-calls-remaining" />
    <set-header name="Accept" exists-action="override">
      <value>application/json, text/event-stream</value>
    </set-header>
    <include-fragment fragment-id="foundry-tool-content-safety" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="X-Google-MCP-Governed" exists-action="override">
      <value>google-user-oauth</value>
    </set-header>
    <include-fragment fragment-id="foundry-tool-content-safety" />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
