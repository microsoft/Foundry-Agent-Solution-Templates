<fragment>
  <set-variable name="endUserKey" value='@(context.Request.Headers.GetValueOrDefault("x-client-end-user-key", ""))' />
  <choose>
    <when condition='@(!Regex.IsMatch((string)context.Variables["endUserKey"], @"^platform/[0-9a-f]{64}$"))'>
      <return-response>
        <set-status code="403" reason="Forbidden" />
        <set-body>A valid platform-derived end-user identity is required.</set-body>
      </return-response>
    </when>
  </choose>
  <llm-token-limit
    counter-key='@("project/__PROJECT_NAME__/end-user/" + (string)context.Variables["endUserKey"] + "/tpm/{{policy-user-tokens-per-minute}}/quota-hour/{{policy-user-token-quota-per-hour}}")'
    tokens-per-minute="{{policy-user-tokens-per-minute}}"
    token-quota="{{policy-user-token-quota-per-hour}}"
    token-quota-period="Hourly"
    remaining-tokens-header-name="remaining-tokens"
    remaining-quota-tokens-header-name="remaining-quota-tokens"
    estimate-prompt-tokens="false" />
</fragment>
