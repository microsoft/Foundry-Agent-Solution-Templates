# Azure deployment target
AZURE_ENV_NAME=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus

# Existing Microsoft Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_NAME=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# New application resources
AZURE_RESOURCE_PREFIX=deepagent
AZURE_CONTAINER_REGISTRY_NAME=
AZURE_STATIC_WEB_APP_NAME=
COSMOS_DATABASE_NAME=deepagent
COSMOS_CONTAINER_NAME=domain
