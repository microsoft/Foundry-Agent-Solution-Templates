# Required for local Foundry access.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=langgraph-deep-agents
FOUNDRY_AGENT_VERSION=
FOUNDRY_MODEL_NAME=

# Required only when COSMOS_ENDPOINT is configured.
COSMOS_DATABASE_NAME=
COSMOS_CONTAINER_NAME=

LOCAL_DEVELOPMENT=true
LOCAL_OWNER_ID=local-developer
LOCAL_USER_NAME=Local developer
LOCAL_USER_EMAIL=developer@example.com